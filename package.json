{
  "name": "budgetbuddy",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --watchAll",
    "test:web": "jest --config=jest.web.config.js",
    "test:native": "jest --testPathIgnorePatterns \".*\\.web\\.test\\.tsx$\""
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo/vector-icons/.*|expo-symbols/.|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-gifted-charts|gifted-charts-core))"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/stack": "^7.4.2",
    "appwrite": "^18.1.1",
    "expo": "^54.0.9",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.9",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.11",
    "expo-web-browser": "~15.0.7",
    "jest": "~29.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.4",
    "react-native-appwrite": "^0.9.2",
    "react-native-canvas": "^0.1.40",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.61",
    "react-native-paper": "^5.14.5",
    "react-native-pie-chart": "^4.0.1",
    "react-native-popup-menu": "^0.18.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.1",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "@types/react-native-dotenv": "^0.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^30.0.4",
    "bun-types": "^1.2.17",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expect": "^30.0.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^30.0.4",
    "jest-expo": "~54.0.12",
    "react-test-renderer": "^19.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
